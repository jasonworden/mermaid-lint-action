{
  "name": "mermaid-lint-action",
  "version": "1.0.0",
  "description": "GitHub Action — validate Mermaid diagrams with inline PR annotations",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "test": "node --test test/annotate.test.js",
    "pretest": "node -e \"require('./src/annotate.js')\" && echo 'annotate.js loads OK'"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.0"
  }
}
