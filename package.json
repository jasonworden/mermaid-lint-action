{
  "name": "mermaid-lint-action",
  "version": "1.1.0",
  "description": "GitHub Action — validate Mermaid diagrams with inline PR annotations",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "verify-dist": "npm run build && node scripts/verify-dist.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\""
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.0"
  }
}
